{
  "name": "@storybookjs/vitest-plugin-sveltekit",
  "version": "0.0.0",
  "description": "Storybook and Vitest support for SvelteKit remote functions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/labs.git",
    "directory": "packages/vitest-plugin-sveltekit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./vite": "./dist/vite.mjs",
    "./storybook": "./dist/storybook.mjs",
    "./vitest": "./dist/vitest.mjs",
    "./remote.mock": "./dist/remote.mock.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --no-clean",
    "prepare": "vp pack",
    "prepack": "vp pack",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vp run --filter ./examples/kit-app test:e2e",
    "example:dev": "vp run --filter ./examples/kit-app dev",
    "example:storybook": "vp run --filter ./examples/kit-app storybook",
    "example:storybook:build": "vp run --filter ./examples/kit-app storybook:build",
    "example:test": "vp run --filter ./examples/kit-app test",
    "example:check": "vp run --filter ./examples/kit-app check"
  },
  "dependencies": {
    "oxc-parser": "^0.156.0",
    "pathe": "^1.1.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.1.0",
    "storybook": "^11.0.0-alpha.8",
    "svelte": "^5.57.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/kit": "3.1.1",
    "storybook": "11.0.0-alpha.8",
    "svelte": "^5.57.3",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
