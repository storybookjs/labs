# Example values, no secrets. Stories and tests never get the private ones: the plugin gives
# `$app/env/private` only the values in its `env` option (the e2e checks `storybook build`).
API_TOKEN=dot-env-secret-91f0
# Not declared in `src/env.ts`: a server mode `storybook build` leaves both out (checked by the
# e2e, which sets `E2E_SHELL_CANARY` in the shell).
UNDECLARED_CANARY=undeclared-canary-5e2a
EXPANDED_CANARY=${E2E_SHELL_CANARY}
