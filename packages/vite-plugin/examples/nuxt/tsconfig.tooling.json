{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "storybook-middleware.ts",
    "vite.config.ts",
    ".storybook/**/*.ts",
    "playwright.config.ts",
    "e2e-tests/**/*.ts"
  ]
}
