{
  "name": "@storybookjs/vite-plugin-angular-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "ng serve",
    "build": "pnpm run typecheck && ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p .storybook/tsconfig.json --noEmit && tsc --noEmit",
    "storybook": "vite --mode storybook --host 127.0.0.1 --port 5205 --strictPort",
    "storybook:build": "vite build --mode storybook",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@angular-devkit/architect": "0.2102.24",
    "@angular-devkit/core": "21.2.24",
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@playwright/test": "1.58.2",
    "@storybook/angular-vite": "https://pkg.pr.new/@storybook/angular-vite@bd420ab3b60",
    "@types/node": "^22.20.3",
    "storybook": "https://pkg.pr.new/storybook@bd420ab3b60",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
