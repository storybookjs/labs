@@ -0,0 +1,86 @@
+import { app, _goto, handle_error, refreshAll, query_map, live_query_map, query_responses, prerender_responses } from '../client.js';
+import { navigating, page, notify_version } from '#app/state/client';
+
+/**
+ * @typedef {object} RemoteEnv
+ * @property {typeof fetch} fetch
+ * @property {Record<string, (data: any) => any>} decoders
+ * @property {Record<string, (data: any) => any>} encoders
+ * @property {{ url: URL }} page
+ * @property {{ to: { url: URL } | null } | null} navigating
+ * @property {(url: string | URL, opts?: { refreshAll?: boolean }) => Promise<void>} goto
+ * @property {() => Promise<void>} refreshAll
+ * @property {(error: unknown, event: { params: Record<string, string>; route: { id: string | null }; url: URL }) => Promise<App.Error>} handleError
+ * @property {(version: string | null) => void} notifyVersion
+ */
+
+// TEMPORARY labs patch: stands in for the client env setter of sveltejs/kit PR A (SB-2442).
+// Replace with the real diff when it lands.
+
+/** @type {RemoteEnv} */
+const default_env = {
+	fetch: (input, init) => fetch(input, init),
+	get decoders() {
+		return app.decoders;
+	},
+	get encoders() {
+		return app.encoders;
+	},
+	get page() {
+		return page;
+	},
+	get navigating() {
+		return navigating;
+	},
+	goto: (url, opts) => _goto(url, opts),
+	refreshAll: () => refreshAll(),
+	handleError: (error, event) => handle_error(error, event),
+	notifyVersion: (version) => notify_version(version)
+};
+
+/** @type {RemoteEnv} */
+export let env = default_env;
+
+/**
+ * Overrides parts of the environment the remote function client runtime reads.
+ * Pass `null` to restore the default, router-backed environment.
+ * @param {Partial<RemoteEnv> | null} overrides
+ */
+export function set_remote_env(overrides) {
+	env = overrides
+		? Object.defineProperties(
+				Object.create(default_env),
+				Object.getOwnPropertyDescriptors(overrides)
+			)
+		: default_env;
+}
+
+/** @type {Set<() => void | Promise<void>>} */
+const reset_callbacks = new Set();
+
+/** @param {() => void | Promise<void>} callback */
+export function on_remote_reset(callback) {
+	reset_callbacks.add(callback);
+}
+
+/**
+ * Drops every cached query, live query and prerender result and resets form state, so the next
+ * call fetches again. Meant for test runners that render many components in one page.
+ * @returns {Promise<void>}
+ */
+export async function reset_remote_state() {
+	for (const map of [query_map, live_query_map]) {
+		for (const entries of map.values()) {
+			for (const entry of entries.values()) {
+				/** @type {any} */ (entry.resource)?.destroy?.();
+				entry.cleanup();
+			}
+		}
+		map.clear();
+	}
+
+	for (const key in query_responses) delete query_responses[key];
+	for (const key in prerender_responses) delete prerender_responses[key];
+
+	await Promise.all(Array.from(reset_callbacks, (callback) => callback()));
+}
