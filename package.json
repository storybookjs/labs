{
  "name": "@storybookjs/labs",
  "version": "1.0.0",
  "private": true,
  "description": "Experiments from the Storybook team",
  "homepage": "https://github.com/storybookjs/labs#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/labs/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/labs.git"
  },
  "type": "module",
  "scripts": {
    "new": "node scripts/create-package.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.26.0"
}
