{
  "name": "@storybookjs/labs",
  "version": "1.0.0",
  "private": true,
  "description": "Experiments from the Storybook team",
  "homepage": "https://github.com/storybookjs/labs#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/labs/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/labs.git"
  },
  "type": "module",
  "scripts": {
    "new": "node scripts/create-package.ts",
    "build": "vp run --filter \"./packages/*\" build",
    "typecheck": "tsc --noEmit && vp run --filter \"./packages/*\" typecheck",
    "test": "vp test run",
    "lint": "vp lint --no-error-on-unmatched-pattern",
    "lint:fix": "vp lint --fix --no-error-on-unmatched-pattern",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:dev",
    "@types/node": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.26.0"
}
