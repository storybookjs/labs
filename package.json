{
  "name": "@storybookjs/labs",
  "version": "1.0.0",
  "private": true,
  "description": "Experiments from the Storybook team",
  "homepage": "https://github.com/storybookjs/labs#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/labs/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/labs.git"
  },
  "type": "module",
  "scripts": {
    "new": "node scripts/create-package.ts",
    "build": "pnpm --filter \"./packages/*\" --if-present build",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" --if-present typecheck",
    "test": "vitest run",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:dev",
    "@types/node": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.26.0"
}
